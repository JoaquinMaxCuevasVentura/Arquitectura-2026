+def dentro_poligono(x, y, pts):
+    """Prueba punto en polígono (par-impar)."""
+    dentro = False
+    for (x0, y0), (x1, y1) in zip(pts, pts[1:] + pts[:1]):
+        if (y0 > y) != (y1 > y) and x < x0 + (y - y0) * (x1 - x0) / (y1 - y0):
+            dentro = not dentro
+    return dentro
+
